; ps3eye_video.inf
; Driver INF for PlayStation Eye video interface (MI_00) over WinUSB
; Windows 10 x64 declarative install

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88bae032-5a81-49f0-bc3d-a4ff138216d6}
Provider    = %ProviderName%
CatalogFile = ps3eye_video.cat
DriverVer   = 10/27/2026, 1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_1415&PID_2000&MI_00

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include    = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName     = %ServiceName%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[USB_Install.HW]
AddReg = AddDeviceInterfaceGUID

[AddDeviceInterfaceGUID]
HKR,,DeviceInterfaceGUIDs,0x10000,%DeviceGUID%

[Strings]
ProviderName     = "PS3Eye Project"
ManufacturerName = "Nam Tai / Sony"
DeviceName       = "PS3 Eye Video Interface (MI_00)"
ServiceName      = "WinUSB - PS3 Eye Video"
DeviceGUID       = "{4BCC4C51-4249-4AE8-98BF-356B2C530E77}"
