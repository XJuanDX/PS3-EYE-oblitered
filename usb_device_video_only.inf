; usb_device_video_only.inf
; Driver nativo WinUSB para la interfaz de video (MI_00) de Sony PlayStation 3 Eye.
; Deja intacta la interfaz MI_01 para que usbaudio.sys maneje el microfono.

[Version]
Signature   = "$Windows NT$"
Class       = "Camera"
ClassGuid   = {ca3e7ab9-b4c2-4ae6-8251-579ef933890f}
Provider    = %VendorName%
CatalogFile = usb_device.cat
DriverVer   = 10/27/2026, 1.0.0.0
PnpLockdown = 1

[Manufacturer]
%VendorName% = PS3Eye_Device, NTamd64, NTx86, NTarm

[PS3Eye_Device.NTamd64]
%DeviceName% = USB_Install_Video, USB\VID_1415&PID_2000&MI_00

[PS3Eye_Device.NTx86]
%DeviceName% = USB_Install_Video, USB\VID_1415&PID_2000&MI_00

[PS3Eye_Device.NTarm]
%DeviceName% = USB_Install_Video, USB\VID_1415&PID_2000&MI_00

[USB_Install_Video]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install_Video.Services]
Include    = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName     = %DeviceName%
ServiceType     = 1                  ; SERVICE_KERNEL_DRIVER
StartType       = 3                  ; SERVICE_DEMAND_START
ErrorControl    = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary   = %12%\WinUSB.sys

[USB_Install_Video.HW]
AddReg = AddDeviceInterfaceGUID

[AddDeviceInterfaceGUID]
HKR,,DeviceInterfaceGUIDs,0x10000,%DeviceGUID%

[Strings]
VendorName      = "Sony"
DeviceName      = "PS3 Eye Camera"
DeviceGUID      = "{4BCC4C51-4249-4AE8-98BF-356B2C530E77}"
